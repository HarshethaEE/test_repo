{
  "name": "ui-visual-tests",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test:auth": "playwright test --project=setup --headed",
    "discover:pages": "tsx scripts/discover-pages.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test -g \"screenshot:\" --update-snapshots",
    "test:visual:report": "playwright show-report",
    "record:fixtures": "tsx scripts/record-fixtures.ts",
    "test:screenshots": "playwright test -g \"screenshot:\"",
    "test:layout": "playwright test -g \"layout:|resize:\"",
    "report:responsive": "node scripts/open-responsive-report.mjs",
    "test:mobile": "playwright test --project=iphone --project=android",
    "test:tablet": "playwright test --project=ipad",
    "report:zip": "node scripts/zip-responsive-report.mjs"
  },
